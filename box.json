{
  "name": "r2sdk",
  "slug": "r2sdk",
  "version": "0.1.0",
  "type": "modules",
  "author": "Eric Peterson <eric@elpete.com>",
  "shortDescription": "Cloudflare R2 client using the S3 API",
  "dependencies": {
    "s3sdk": "5.8.1+119"
  },
  "installPaths": {
    "s3sdk": "modules/s3sdk/"
  },
  "ignore": [
    "**/.*",
    "build",
    "test-harness",
    "/modules/",
    "/server*.json",
    "/CONTRIBUTING.md",
    "/SECURITY.md"
  ],
  "license": [
    {
      "type": "Apache2",
      "URL": "https://www.apache.org/licenses/LICENSE-2.0"
    }
  ],
  "keywords": "cloudflare,r2,s3,coldbox,storage,boxlang,cfml",
  "scripts": {
    "format": "cfformat run models,ModuleConfig.cfc,test-harness/**/*.cfc,build/*.cfc --overwrite && task run taskFile=build/VerifyDependencyTracking.cfc",
    "format:check": "cfformat check models,ModuleConfig.cfc,test-harness/**/*.cfc,build/*.cfc && task run taskFile=build/VerifyDependencyTracking.cfc",
    "test:dependency-tracking": "task run taskFile=build/VerifyDependencyTracking.cfc",
    "test": "!python3 build/test.py",
    "test:sdk-selection": "task run taskFile=build/VerifySdkSelection.cfc",
    "build:module": "task run taskFile=build/Package.cfc",
    "build:docs": "task run taskFile=build/Docs.cfc"
  },
  "devDependencies": {
    "commandbox-cfformat": "0.21.0",
    "commandbox-docbox": "2.5.0+5"
  },
  "homepage": "https://github.com/coldbox-modules/r2sdk",
  "documentation": "https://github.com/coldbox-modules/r2sdk/blob/main/README.md",
  "bugs": "https://github.com/coldbox-modules/r2sdk/issues",
  "repository": {
    "type": "git",
    "URL": "https://github.com/coldbox-modules/r2sdk"
  }
}
